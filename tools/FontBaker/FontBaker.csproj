<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone build-time tool. It lives outside src/ so the tModLoader SDK
       never compiles or packs it into the .tmod. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrelamiumIII.Tools.FontBaker</RootNamespace>
    <AssemblyName>FontBaker</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: bakes must be reproducible, and 3.x reworked the drawing API. -->
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
  </ItemGroup>

</Project>
