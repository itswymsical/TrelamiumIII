<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

  <Import Project="../../build/TrelamiumIII.Build.targets" />

  <PropertyGroup>
    <AssemblyName>TrelamiumIII</AssemblyName>
    <RootNamespace>TrelamiumIII</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Common\Generation\" />
    <Folder Include="Content\Menus\" />
    <Folder Include="Localization\ActLang\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Core\Items\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Core\Items\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Core\Items\**" />
  </ItemGroup>

  <ItemGroup>
    <LocalizationCompile Remove="Core\Items\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="Core\Items\**" />
  </ItemGroup>

  <ItemGroup>
    <ShaderCompile Remove="Core\Items\**" />
  </ItemGroup>

</Project>
