<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

  <Import Project="../../build/TrelamiumIII.Build.targets" />

  <PropertyGroup>
    <AssemblyName>TrelamiumIII</AssemblyName>
    <RootNamespace>TrelamiumIII</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Content\Menus\" />
    <Folder Include="Content\Lore\" />
    <Folder Include="Assets\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Content\Agate\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Content\Agate\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Content\Agate\**" />
  </ItemGroup>

  <ItemGroup>
    <LocalizationCompile Remove="Content\Agate\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="Content\Agate\**" />
  </ItemGroup>

  <ItemGroup>
    <ShaderCompile Remove="Content\Agate\**" />
  </ItemGroup>

</Project>
