<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

  <Import Project="../../build/TrelamiumIII.Build.targets" />

  <PropertyGroup>
    <AssemblyName>TrelamiumIII</AssemblyName>
    <RootNamespace>TrelamiumIII</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TmlVersion>steam</TmlVersion>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Core\Rarities\Definitions\" />
    <Folder Include="Localization\DialogueLibrary\Silvian\" />
  </ItemGroup>

  <!-- Reference only until ported to Core/Tiles/CustomTree: still uses Reverie namespaces and taiga grass tiles this mod doesn't have.
       A static Compile Remove doesn't apply with this SDK, so the files are dropped just before compilation, like the SDK's own removals. -->
  <Target Name="ExcludeSpruceReference" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="Content\Taiga\SpruceTree.cs;Content\Taiga\SpruceSapling.cs" />
    </ItemGroup>
  </Target>

</Project>
