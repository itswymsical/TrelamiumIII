void noise_Stage(inout Px px)
{
    float2 p = px.p * noise_Scale;
    p = p * noise_Stretch + noise_Drift * Time + px.q;

    float n = LabFbm(noise_Noise, p, 6);

    px.erosion += noise_Strength * (n - noise_Pivot);
    px.noise = lerp(px.noise, n, noise_ShadeShare);
}

