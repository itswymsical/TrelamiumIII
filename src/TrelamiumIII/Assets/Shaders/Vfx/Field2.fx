void shade_Stage(inout Px px)
{
    float t = 1.0 - exp(-px.depth / max(shade_Range, 0.001));
    float shade = saturate(t * (0.55 + 0.9 * px.noise));

    px.shade = floor(shade * shade_Bands) / max(shade_Bands - 1.0, 1.0);
}

