BookLibrary: {
	LoreGlossary: {
		Tidemark: {
			Term: tidemark
			Definition: The line a receding water level leaves behind. In the lower archive, a way of dating a shelf.
		}

		Figures: {
			Term: figures
			Definition: Recorded numbers; the readings of a survey. Laine's are tallies of a parish's disposition toward itself.
		}

		Silhouette: {
			Term: Silhouette
			Definition: A shape or outline visible due to the light cast upon it.
		}

		Unfalsifiable: {
			Term: unfalsifiable
			Definition:
				'''
				Of a claim: so framed that no observation could count against it. 
				A denial and confirmation becomes evidence.
				'''
		}

		Situated: {
			Term: situated
			Definition: Of a property: belonging to a thing only in relation to its place. Cannot be carried elsewhere.
		}

		Stipend: {
			Term: stipend
			Definition: A fixed sum of money paid to a person for services rendered, often in a scholarly or religious context.
		}

		TrelamiumIII: {
			Term: TrelamiumIII
			Definition: A pleasant absence of mind. From the old French resverie: delirium, raving, the wandering of a mind out of its own house. Laine took the later sense.
		}

		FalseLight: {
			Term: false light
			Definition: Laine's final term, offered in retraction of his first. That which comes off light, cannot arise without it, and is not light.
		}

		Substratica: {
			Term: substratica
			Definition: In a phenomenal sense; having to do with the nature of what underlies.
		}
	}

	LoreUI: {
		OpenBook: Read: {0}
		ContentsTab: Contents
		ContentsTooltip: Turn to the contents
		BookmarkEmpty: Mark this page
		BookmarkPage: p. {0}
	}
}