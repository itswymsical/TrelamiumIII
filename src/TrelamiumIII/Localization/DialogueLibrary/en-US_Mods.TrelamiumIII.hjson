DialogueLibrary: {
	Example: {
		Inflection: {
			Line1.Text: Wait a second... [Yo]u! did this![] Didn['t] you?
			Line2.Text: Don't [look] at me like that.[] I'm [perfectly] fine.
			Line3.Text: Hear that [climb]? And the way this one [sinks]?
		}
	}

	Sonder: {
		SonderGreeting: {
			Line1.Text: Greetings, [speakerName:player]. [] I am Sonder,[] a mere wanderer of the world.[] I have traveled far and wide, and I have many stories to tell.
			Line2.Text: If you wish to hear them,
			Line3.Text: you must first answer a question.

			Line4: {
				Text: Have you experienced...[] the feeling of sonder?
				Choice1.Text: No, I have not.
				Choice2.Text: I am experiencing it now.
				Choice3.Text: I have felt it many times.
				Choice4.Text: ...
			}
		}

		SonderChoice_1: {
			Line1.Text: Sonder is the realization that each random passerby is living a life as vivid and complex as your own.
			Line2.Text: They have their own ambitions, friends, routines, worries, and inherited craziness.
			Line3.Text: They are not simply background characters in your story;[] They are the main character of their own story.
		}

		SonderChoice_2.Line1.Text: Ah, yes. I suppose that is true.[] Perchance in more ways than one.
		SonderChoice_3.Line1.Text: Indeed.[] It is a rare and beautiful thing to feel sonder, and I am glad you have experienced it.
		SonderChoice_4.Line1.Text: I see.[] Well, I hope you will have the opportunity to experience it in the future.
	}

	Sophie: {
		Greeting: {
			Line1: {
				Text: Oh,[] hey there![] Didn't notice you sneak by.[] Anything I can do for ya?
				Choice1.Text: Nah, nothin' in particular.
				Choice2.Text: I'm a bit lost.
				Choice3.Text: Nope, I just like staring.
			}
		}

		GreetingAnswer1.Line1.Text: ah[]...[]well the name's Sophie.
		GreetingAnswer2.Line1.Text: Lost?[]I think you're joking.
		GreetingAnswer3.Line1.Text: Alright kid,[] get lost already.
	}

	NerdySlime: {
		Greeting.Line1.Text: Hello, [speakerName:player]! [] I have a task for you!

		Job1: {
			Line1.Text: "[glorb gorbblpoo popo loopgorlb]"
			Line2.Text: '''"Satisfactory, fleshling.[] My graditutes in this reward."'''
		}
	}

	Merchant: {
		GoldMine_Greeting: {
			Line1.Text: I'm hearing word there'll be a flood of grubby handed 'forest investors' coming through our way[] and I'm not too keen on the way they run their politics!
			Line2.Text: They want gold, our resources, to capitalize the area?
			Line3.Text: There's no way that's gettin' past me![] So we'll give gold, we'll give 'em fool's gold!
		}

		GoldMine_SurplusOre: {
			Line1.Text: Hehe...[] I appreciate the tenacity,[] but I don't think these investors are gonna bat an eye at raw "gold".
			Line2.Text: How's about you grab the more appealing items?[] Bars will do![] Furniture even more so.
			Line3.Text: Gather anything that could be made from a copper bar, and bring it back.
		}

		GoldMine_SurplusBars.Line1.Text: Copper bars,[] Shiny and beautiful...[] Although...[] seems like we might have enough, seek out furniture or tools.

		GoldMine_SurplusFurniture: {
			Line1.Text: That's plenty of furniture![] We should be good on that now.[] How's about it some bars?
			Line2.Text: It might be crazy to say this as a merchant,[] but that stock market can crash![] Heheh...
			Line3.Text: Those folks won't know what hit 'em.[] If they REALLY think they can economically bully us,[] we'll show 'em a little bit of our own ingenuity.
		}

		GoldMine_SurplusTools.Line1.Text: Handy work on those tools![] but I need a little more than that, friend! Look around for some furniture, or bars.[] That's the kind of stuff that'll get those investors' attention.

		GoldMine_Complete: {
			Line1.Text: Well,[] that should do it![] Let's see if we can make a deal with those investors.
			Line2.Text: Thanks for your help, [speakerName:player]![] Come on back and I'll have your little somethin' ready.
		}
	}

	Kraken: {
		Greeting: {
			Line1.Text: Huh?[] Hello there.
			Line2.Text: Didn't notice ya standing there.[] It's a bit creepy...
		}
	}
}
