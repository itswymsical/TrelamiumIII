#  Line text + anchor markers only. Flow lives in Core/Dialogue/Definitions.
#
#  Anchors:
#    []       point anchor  - pairs with a point affect (Pause)
#    [text]   span anchor   - pairs with a span affect (Wave, Shake, Slow, Fast, Pitch);
#                             the text inside the brackets is what gets displayed
#    [speakerName:Merchant]  substituted with that NPC's given name (not an affect anchor)

DialogueLibrary: {
	Example: {
		Greeting: {
			Line1.Text: This line pauses right here[] before finishing.
			Line2.Text: And this one has a [wavy] word in it.
		}
	}

	NerdySlime: {
		Greeting.Line1.Text: Hello, [speakerName:player]! [] I have a task for you!

		Job1: {
			Line1.Text: "[glorb gorbblpoo popo loopgorlb]"
			Line2.Text: '''"Satisfactory, fleshling.[] My graditutes in this reward."'''
		}
	}

	Guide: {
		HomeForager.Line1.Text: Hey, [speakerName:player]! [] I have a task for you!

		HomeForager_Greeting: {
			Line1.Text: Hey,[] [speakerName:player]!
			Line2.Text: I know you're pretty new here, so I want to make sure you have a good start.[] I have a few things for you to do, and if you complete them,[] I'll give you a reward!
			Line3.Text: First,[] I need you to gather some resources for me.[] You can find them in the forest nearby.[] Once you have them, bring them back to spawn and I'll let you know what to do next.[] Good luck!
		}

		HomeForager_Occupied.Line1.Text: Sorry, [speakerName:player]![] It looks like that housing is already occupied.[] Maybe try another one.
	}
}
