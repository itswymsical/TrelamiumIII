DialogueLibrary: {
	Argie: {
		Greeting: {
			Line1.Text: Oh![] A visitor![] Hello! Hello![] Don't touch anything.
			Line2.Text: Not with your bare hands, anyway.[] I'm not saying something bad will happen![] I just don't know that it won't.

			Line3: {
				Text: I am Argie![] the GREATEST Mycologist to ever exist![] uhm....[] Anyways, this is my lab, and those are my colleagues.
				Choice1.Text: colleagues?
				Choice2.Text: ...
			}
		}

		Greeting_Letter: {
			Line1.Text: Oh![] A visitor![] Hello! Hello![] Don't touch anything.

			Line2: {
				Text: ...What's that you're holding?
				Choice1.Text: A letter.
				Choice2.Text: ...
			}
		}

		Letter: {
			Line1.Text: That's Mr. Substrate's handwriting![] ...Silvian kept this?[] He hasn't written me a word since the funeral.

			Line2: {
				Text: ...[] Thank you.[] I'll read this properly when I have the time.
				Choice1.Text: Are you ok?
				Choice2.Text: ...
			}
		}

		Brighter: {
			Line1.Text: ...Hold still a secon.[] The fungi glow brighter around you...![] That's so peculiar.
			Line2.Text: I've logged every glowcap in this grotto for the past six years.[] They have never once done that.
			Line3.Text: Okay.[] Okay![] New plan![] You're going to help me out.
			Line4.Text: I need fungi from outside the grotto to compare against.[] Fly agaric from the surface grass,[] puffballs,[] and dewdrop bonnets.
			Line5.Text: Puffballs come off Scrunglepuffs,[] but they don't like giving them up.[] The dewdrops only grow on clouds,[] up on the floating islands.
			Line6.Text: Bring them back and I'll tell you what I find.[] Probably.
		}

		LateLetter: {
			Line1.Text: Is that...[] John's hand?[] Silvian kept this?
			Line2.Text: ...[] Thank you.[] I'll read it later.[] Properly.
		}

		JobOffer.Line1.Text: Where were we?[] Right.[] Fly agaric,[] puffballs,[] dewdrop bonnets.[] I need samples!

		MycologyHunt_Greeting: {
			Line1.Text: Five fly agaric,[] three puffballs,[] three dewdrop bonnets.[] Please Write it down![] I would myself,[] but I'm out of paper.
			Line2.Text: And gloves![] Wear gloves while handling!
		}

		MycologyHunt_HandIn: {
			Line1: {
				Text: You found them?[] Let me see,[] let me see!
				Choice1.Text: Here.
				Choice2.Text: Not yet.
			}
		}

		MycologyHunt_Complete: {
			Line1.Text: Fly agaric: calm.[] Puffball: calm.[] Bonnet: calm,[] and a little damp.
			Line2.Text: Splendid![] The mycelium under this grotto has been flinching for weeks.
			Line3.Text: Something down there is big,[] and it's shifting around.

			Line4: {
				Text: I need spore samples from around the grotto to work out where.[] The local creatures have been infested with them:[] skellies,[] slimes,[] and even scrunglepuffs.[] Will you help?
				Choice1.Text: Of course.
				Choice2.Text: Maybe later.
			}
		}

		SurveyOffer: {
			Line1: {
				Text: That thing under the grotto.[] I still need those spore samples, friend!
				Choice1.Text: I'll get them.
				Choice2.Text: Maybe later.
			}
		}

		SurveyOffer_Yes.Line1.Text: Ten samples ought to do it![] Twelve if you like me, hehe.
		SurveyOffer_No.Line1.Text: Okay.[] I'll just sit here.[] On top of it.
		SporeSurvey_Greeting.Line1.Text: The Spore samples, yes.[] Just need about ten, friend![] Don't breathe them through your mouth!

		SporeSurvey_HandIn: {
			Line1: {
				Text: Samples?[] Give, give, give!
				Choice1.Text: Here.
				Choice2.Text: Not yet.
			}
		}

		SporeSurvey_Complete: {
			Line1.Text: Whatever thing is,[] it keeps growing under the lab.[] I've collected a few already.
			Line2.Text: Tehy started moving a few hours ago...[] around when you showed up.[] Correlation isn't causation.[] That is, usually the case.
			Line3.Text: I cultured something from your samples.[] It is indeed a spore.[] But I genuinely don't know what it does.
			Line4.Text: So be careful with it.[] If you use it,[] use it on the surface.
			Line5.Text: If something's coming up,[] I'd rather it came up out there than under my lab tiling.
		}

		SporeAgain.Line1.Text: Used it?[] Lost it?[] ...I have plenty![] Take as many as you need, you're my new exterminator!
	}
}
