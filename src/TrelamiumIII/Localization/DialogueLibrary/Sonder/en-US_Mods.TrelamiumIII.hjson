DialogueLibrary: {
	Sonder: {
		SonderGreeting: {
			Line1.Text: Greetings. [] I am Sonder.
			Line2.Text: Before you ask,[] I have one for you; a question....

			Line3: {
				Text: Have you experienced...[] the feeling of sonder?
				Choice1.Text: No...?
				Choice2.Text: Experiencing it now.
				Choice3.Text: Many times.
				Choice4.Text: ...
			}
		}

		SonderChoice_1: {
			Line1.Text: Sonder[] is the realization that each random passerby is living a life as vivid and complex as your own.
			Line2.Text: They have their own ambitions,[] friends,[] routines,[] worries,[] and inherited craziness.
			Line3.Text: They are not simply background characters in your story;[] They are the main character of their own story.
		}

		SonderChoice_2.Line1.Text: Are you, really?[] I suppose that is true.[] Perhaps in more ways than one.
		SonderChoice_3.Line1.Text: Indeed.[] It is a rare and beautiful thing to feel sonder, and I am glad you have experienced it.
		SonderChoice_4.Line1.Text: I see.[] Well, I hope you will have the opportunity to experience it in the future.

		SonderReunion: {
			Line1: {
				Text: It seems we meet again, [speakerName:player].[] What have you come to experience from the last we encountered?
				Choice1.Text: Nothing New..
				Choice2.Text: Many Battles.
				Choice3.Text: Strength.
				Choice4.Text: ...
			}
		}

		SonderExperience_None: {
			Line1: {
				Text: Silence,[] it is a good friend of mine.[] I am glad that she is in your company.
				Choice1.Text: Why do you keep appearing?
				Choice2.Text: ...
			}
		}

		SonderExperience_Bland: {
			Line1: {
				Text: Quite the prosaic answer,[] lest it be thought dishonest.
				Choice1.Text: Why do you keep appearing?
				Choice2.Text: ...
			}
		}

		SonderExperience_Passion.Line1.Text: Hardened so soon by the sport of combat.[] Passion in war is yet a cruel beauty.

		SonderExperience_Strength: {
			Line1.Text: Strength.[] That is a powerful word,[] or perhaps,[] a wise one.
			Line2.Text: A wise man only needs one word to paint a picture.
		}

		SonderAppear: {
			Line1.Text: Am I appearing,[] or have you just arrived?
			Line2.Text: In any case,[] It is time for my depart.[] I will see you again soon, [speakerName:player].
		}

		SonderLeave.Line1.Text: In any case,[] It is time for my depart.[] I will see you again soon, [speakerName:player].
	}
}
