DialogueLibrary: {
	Merchant: {
		CopperStandard_Greeting: {
			Line1.Text: Everybody's out there breakin' their backs for gold.[] Gold,[] gold,[] gold.[] Know what they're diggin' right past to get to it?
			Line2.Text: Copper,[] friend.[] Tons of it.[] Just lyin' around down there,[] and all anybody ever makes out of it is a sad little pickaxe.
			Line3.Text: That's not junk.[] That's an untapped market![] All it needs is somebody with vision,[] and somebody else with a pickaxe.
			Line4.Text: I've got the vision.[] So get on down there and dig me up a mountain of the stuff.
		}

		CopperStandard_Tin.Line1.Text: Whoa,[] whoa.[] That's tin,[] friend.[] I know they look alike.[] That's what tin wants you to think.

		CopperStandard_Set1: {
			Line1.Text: Now that's a fine pile of rocks![] Nobody's gonna pay for rocks, though.[] Trust me,[] I've tried.
			Line2.Text: Get it in a furnace and bring me the bars.[] Bars are a product.
		}

		CopperStandard_Set1HandIn: {
			Line1: {
				Text: There they are![] Not a soul in this town wants those,[] which is exactly how you know we're gonna be rich.[] Let's see 'em.
				Choice1.Text: Have a look.
				Choice2.Text: Not yet.
			}
		}

		CopperStandard_Set2: {
			Line1.Text: Here's the plan.[] Folks don't buy copper,[] 'cause they don't know they want copper.[] You know what they do want?
			Line2.Text: Regular stuff![] So we take the regular stuff,[] and we put copper in it.
			Line3.Text: Start with what sells.[] Folks are always shootin' at somethin'.[] Arrows,[] bullets,[] one of them boomerangs.[] Bring me a sample of each.
			Line4.Text: You'll want an anvil.[] I sell those.[] No discount,[] this is business.
		}

		CopperStandard_Set2HandIn: {
			Line1: {
				Text: Back already?[] You got somethin' I can put a price on?
				Choice1.Text: Here are the samples.
				Choice2.Text: Not yet.
			}
		}

		CopperStandard_Set3: {
			Line1.Text: Let's see.[] The arrow flies.[] The bullet...[] also flies.[] The boomerang came back,[] which I'm told is the idea.
			Line2.Text: So they do everything the regular ones do,[] and they cost more to make.[] I'm no scientist,[] but I don't love that.
			Line3.Text: ...No![] No,[] we're thinkin' too small![] Weapons are a niche![] Everybody's got a home,[] friend![] Torches![] Rope![] Medicine!
			Line4.Text: Put copper in it![] All of it![] And hurry,[] before somebody else thinks of this!
		}

		CopperStandard_Set3HandIn: {
			Line1: {
				Text: Tell me you've got somethin' good.[] I've been tellin' people about this.
				Choice1.Text: Here are the samples.
				Choice2.Text: Not yet.
			}
		}

		CopperStandard_Set4: {
			Line1.Text: Alright.[] The torch burns green.[] Green![] My whole shop looks like somebody died in it.
			Line2.Text: The rope's got a kind of a hum to it.[] Stung me a little in that last storm.[] Can't imagine anybody ever findin' a use for that.
			Line3.Text: And the potion tastes like I licked a handrail.[] I can hear my teeth.
			Line4.Text: ...[] Hold on.[] A fella sold me a gold bunny once.[] Ten gold pieces.[] Best money I ever spent.
			Line5.Text: You know what a gold bunny is?[] It's a bunny,[] with gold on it.
			Line6.Text: ...[] Go catch a bunny.[] I sell nets.
		}

		CopperStandard_Appraisal: {
			Line1.Text: Is that him?[] Give him here.[] Let's have a look at you,[] little fella.
			Line2.Text: Mm.[] Mmhm.[] Now,[] on a good day,[] to the right buyer,[] I could get...[] one copper for him.

			Line3: {
				Text: ...[] You know what?[] Maybe it's not that valuable after all.
				Choice1.Text: I put copper in a bunny for you.
				Choice2.Text: You said it was the future.
				Choice3.Text: So I'm still getting paid, right?
			}
		}

		CopperStandard_Complete: {
			Line1.Text: Alright,[] alright,[] keep your shirt on.[] A deal's a deal.[] Nobody ever said the market was an exact science.
			Line2.Text: Take this.[] Some fella traded it in right before he left town in a hurry.[] It shoots rocks.[] Just regular rocks,[] right up off the floor.
			Line3.Text: ...[] Rocks.[] Everywhere you look,[] and nobody's makin' a dime off 'em.[] Huh.
			Line4.Text: Anyway,[] the bunny stays.[] His name's Penny.
		}
	}
}
