DialogueLibrary: {
	Guide: {
		HomeForager.Line1.Text: Hey, [speakerName:player]! [] I have a task for you!

		HomeForager_Greeting: {
			Line1.Text: Hey,[] [speakerName:player]!

			Line2: {
				Text: Welcome to the land of the living Light[] -- or what most would call Terraria.
				Choice1.Text: How do you know my name?
				Choice2.Text: Land of Light?
				Choice3.Text: How do I skip this?
			}
		}

		HomeForager_Name: {
			Line1.Text: It's in the script.[] In any case, In any case,[] Terraria hasn't been so bright as of late.
			Line2.Text: Anyone with a an arm and a leg would've ran by now.
		}

		HomeForager_Skip: {
			Line1.Text: No clue what you are talking about![] In any case,[] Terraria hasn't been so bright as of late.
			Line2.Text: Anyone with a an arm and a leg would've ran by now.
		}

		HomeForager_LandOfLight: {
		}

		HomeForager_Occupied.Line1.Text: Sorry, [speakerName:player]![] It looks like that housing is already occupied.[] Maybe try another one.
		HomeForager_Repeat.Line1.Text: You already showed me that one![] It's a fine house,[] but the town needs another.
		# One per way a housing check can come back unusable. Keyed from HousingIssue in HomeForager.
		HomeForager_NeedsDoor.Line1.Text: So close![] There's no door on that room, so nobody can get in or out.
		HomeForager_NeedsLight.Line1.Text: It's awfully dark in there![] Hang a torch on the wall, or set a candle down somewhere.
		HomeForager_NeedsTable.Line1.Text: Nearly![] There's nowhere to set anything down. A table will do, or a workbench in a pinch.
		HomeForager_NeedsChair.Line1.Text: It needs somewhere to sit![] A chair,[] or a bed if you're feeling generous.
		HomeForager_SolidTile.Line1.Text: Buddy...[] that's a solid block.
		HomeForager_TooSmall.Line1.Text: That room is a bit of a shoebox, [speakerName:player]![] Give it a few more blocks of height and width, then try again.
		HomeForager_NotEnclosed.Line1.Text: Hm.[] Either that room is enormous, or something is letting the outside in.[] Check for gaps, and remember the background needs walls too.
		HomeForager_Corrupt.Line1.Text: Nobody is going to live there.[] The land itself has turned.[] Find cleaner ground, or clear that out first.
		HomeForager_NoValidSpot.Line1.Text: Everything is there, but there is nowhere to stand![] Clear the floor a little and give them some space.
		# A room from one of the planned houses, checked while the player should be building their own.
		HomeForager_Planned.Line1.Text: That one's from my plans![] Build one of your own this time.

		# Fired as each stage of the job is cleared.
		# Materials gathered: he hands over his plans.
		HomeForager_Set1: {
			Line1.Text: Look at all that![] That's plenty to build with.
			Line2.Text: Here, take my plans.[] Find a good patch of ground near here and lay them out,[] and we'll start with my house.
		}

		# His house staked.
		HomeForager_Set2.Line1.Text: A fine spot![] Now build it just as it's drawn.[] Anything in the way will show up red.

		# His house built, and he's moved in.
		HomeForager_Set3: {
			Line1.Text: Now that's a house![] I'll be moving my things in tonight.
			Line2.Text: There's a merchant passing through who'd stay if he had a roof.[] His plans are on the next page.
		}

		# The Merchant's house staked.
		HomeForager_Set4.Line1.Text: Same as before.[] Build it to the drawing,[] and he'll be along.

		# The Merchant has arrived.
		HomeForager_Set5: {
			Line1.Text: And there he is,[] right on time!
			Line2.Text: One more house,[] and this time no plans.[] Walls all round, a door, a light, a table and a chair.[] Then point the housing menu at it and I'll tell you if it will do.
		}

		# A house of their own.
		HomeForager_Set6: {
			Line1.Text: Well now.[] That's a town.
			Line2.Text: Come and talk to me when you've caught your breath,[] and I'll see you paid properly.[] You've earned it.
		}

		# The hand-in. Replaces the Guide's chat window for as long as the last set is open.
		HomeForager_CheckIn: {
			Line1.Text: There you are.[] Have a look around while you're standing still.
			Line2.Text: Empty rooms this morning,[] neighbours by the end of the week.[] Here, take this.[] Come and find me when you want more work.
		}
	}

	Merchant: {
		GoldMine_Greeting: {
		}

		GoldMine_SurplusOre: {
		}

		GoldMine_SurplusFurniture: {
		}

		GoldMine_Complete: {
		}
	}
}
