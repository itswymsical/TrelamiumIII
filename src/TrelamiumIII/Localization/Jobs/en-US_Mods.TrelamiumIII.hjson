Jobs: {
	// Tooltip lines on an item a job has reserved (Core/Jobs/MarkedItem).
	MarkedItem: {
		ForJob: Reserved for {0}
		Generic: Reserved for a job
		Locked: Cannot be used, sold, or stored
	}

	// Strings for the in-world job board (Core/UI/Jobs/Board).
	UI: {
		ListHeader: Jobs ({0})
		From: From: {0}
		Rewards: Rewards
		NoneAvailable: Nothing available
		TakeJob: Take Job
		Close: Close
		ConfirmPrompt: Take this job?
		ConfirmAccept: Accept
		ConfirmBack: Back
	}
	
	SilvianBotany1: {
		Name: Botanist job i dont have a name for yet
		Description: "'It'll be worth the rewarddd! Trust me!'"

		Tasks: {
			Set0.obj0: Brief with Silvian (let the dialogue play out)
			Set1: { 
				obj0: Collect Dayblooms
				obj1: Collect Blinkroot
				obj2: Collect Sunflower
			}
			Set2.obj0: Return to Silvian
		}
	}

	HomeForager: {
		Name: Home Forager
		Description: '''"I'm a bit particular about housing – you can't have town without townsfolk!"'''

		Tasks: {
			Set0: {
				obj0: Chop down tree logs
				obj1: Mine and gather stone blocks
			}

			Set1.obj0: Create suitible housing for the Guide
			Set2.obj0: Create suitible housing for the Merchant
			Set3.obj0: Create an extra housing
			Set4.obj0: Check in with the Guide
		}
	}

	GoldMine: {
		Name: Gold Mine
		Description:
			'''
			"I'm hearing word there’ll be a flood of investors coming through the forest 
			and I'm not too keen on their politics. They want gold, so we’ll give ‘em fool’s gold!"
			'''

		Tasks: {
			Set0.obj0: Speak with Merchant
			Set1.obj0: Obtain copper objects
			Set2.obj0: Check in with the Merchant
		}
	}
}
