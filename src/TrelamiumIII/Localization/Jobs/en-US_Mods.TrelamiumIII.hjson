Jobs: {
	NerdySlimeI: {
		Name: Nerdy Slime's Sublime Task!
		Description: "'Help me build a quantum relocator!'"

		Tasks: {
			Set0.obj0: Chat with Nerdy Slime
			Set1.obj0: eat a blueberry bandaid
			Set2.obj0: Return to Slime
		}
	}

	HomeForager: {
		Name: Home Forager
		Description: '''"I'm a bit particular about housing – you can't have town without townsfolk!"'''

		Tasks: {
			Set0: {
				obj0: Chop down trees
				obj1: Mine and gather stone blocks
			}

			Set1.obj0: Create suitible housing for the Guide
			Set2.obj0: Create suitible housing for the Merchant
			Set3.obj0: Create an extra housing
			Set4.obj0: Check in with the Guide
		}
	}

	GoldMine: {
		Name: Gold Mine
		Description:
			'''
			"I'm hearing word there’ll be a flood of investors coming through the forest 
			and I'm not too keen on their politics. They want gold, so we’ll give ‘em fool’s gold!"
			'''

		Tasks: {
			Set0.obj0: Speak with Merchant
			Set1.obj0: Obtain copper objects
			Set2.obj0: Create suitible housing for the Merchant
			Set3.obj0: Create an extra housing
			Set4.obj0: Check in with the Guide
		}
	}
}
