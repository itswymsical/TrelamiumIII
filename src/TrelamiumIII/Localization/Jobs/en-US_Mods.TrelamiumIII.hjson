Jobs: {
	// Tooltip lines on an item a job has reserved (Core/Jobs/MarkedItem).
	MarkedItem: {
		ForJob: Reserved for {0}
		Generic: Reserved for a job
		Locked: Cannot be used, sold, or stored
	}

	// Strings for the in-world job board (Core/UI/Jobs/Board).
	UI: {
		ListHeader: Jobs ({0})
		From: From: {0}
		Rewards: Rewards
		NoneAvailable: Nothing available
		TakeJob: Take Job
		Close: Close
		ConfirmPrompt: Take this job?
		ConfirmAccept: Accept
		ConfirmBack: Back
		// The card that stands up over a hovered job indicator.
		HoverOne: Job available
		HoverMany: "{0} jobs available"
		HoverMore: +{0} more
		HoverHint: More info
	}

	// Building a structure from its blueprint (Core/Jobs/Blueprints).
	Blueprint: {
		// After a blueprint task while it has no site. {0} = the key bound to Stake Blueprint.
		Unstaked: (press {0} to pick a site)
		Unbound: (bind Stake Blueprint in Controls to pick a site)
		// Over the blueprint while it follows the cursor.
		HoldHint: Left-click to build here, right-click to cancel
		OffWorld: Too close to the edge of the world
		// Held outside a blueprint's BlueprintZone.NearSpawn.
		FarFromSpawn: Too far from spawn
	}

	// The one-time walkthrough after the Guide's opening job (Core/UI/Jobs/JobTrackerHint).
	TrackerHint: {
		// {0} = the key bound to the inventory.
		OpenInventory: Press {0} to open your inventory.
		TrackerTitle: Job Tracker
		TrackerBody: Shows your progress on every job you've taken.
		Dismiss: Got it
	}

	// Repeatable gathering jobs from wandering jobbers (Content/NPCs/Jobbers).
	Jobber: {
		Name: Odd Job
		Description: "'Got a bit of work, if you're interested.'"
		Abandoned: "{0} is gone, and the odd job with them."

		// {0} = amount, {1} = item name.
		Requests: {
			Ore: "'I'm short on ore. {0} {1} would set me right.'"
			Wood: "'Need timber for a project. Bring me {0} {1}?'"
			Gem: "'I've got a buyer for gems. Find me {0} {1} and I'll cut you in.'"
			Block: "'Building something. Could use {0} {1}.'"
			Accessory: "'Been after a {1} for ages. Spare one?'"
		}

		Tasks: {
			Gather: Collect {0}
			HandIn: Return to {0}
		}
	}

	HerbalForager: {
		Name: Trampled Beds
		Description: "'Slimes got into the garden. I could use a hand.'"

		Tasks: {
			// GatherItemTask: {0} = item name, {1} = amount.
			Set1: {
				obj0: Craft seed beds (any soil)
				obj1: Collect {0}
				obj2: Collect {0}
				obj3: Bring everything to Silvian
			}
		}
	}

	BotanyBasics: {
		Name: Green Thumb
		Description: "'Botany's just payin' attention to what a plant wants.'"

		Tasks: {
			Set0: {
				obj0: Place seed beds
				obj1: Plant seeds in your seed beds
			}

			Set1.obj0: Tell Silvian how it went

			Set2: {
				obj0: Plant seeds in the soil they favor
				obj1: Harvest a blooming herb
			}

			Set3.obj0: Show Silvian your harvest
		}
	}

	MycologyHunt: {
		Name: Fungal Survey
		Description: "'Samples from outside the grotto. Gloves, please.'"

		Tasks: {
			// GatherItemTask: {0} = item name, {1} = amount.
			Set0: {
				obj0: Collect {0} shrooms
				obj1: Collect {0} from Scrunglepuffs
				obj2: Collect {0} from floating islands
				obj3: Bring everything to Argie
			}
		}
	}

	SporeSurvey: {
		Name: Something Under the Grotto
		Description: "'Something big is moving under the lab. I'd like to know where.'"

		Tasks: {
			Set0: {
				obj0: Collect {0} from the glowing mushroom biome's creatures
				obj1: Bring the samples to Argie
			}
		}
	}

	HomeForager: {
		Name: Home Forager
		Description: '''"This place is empty... you look strong!"'''

		Tasks: {
			// GatherItemTask: {0} = item name, {1} = amount.
			Set0: {
				obj0: Chop {0}
				obj1: Dig up {0}
				obj2: Craft a {0}
				obj3: Craft a {0}
			}

			Set1.obj0: Use the Guide's plans to pick a spot near spawn for his house

			Set2: {
				obj0: Raise the frame of the Guide's house
				obj1: Put up its walls
				obj2: Furnish it
			}

			Set3.obj0: Pick a spot near spawn for the Merchant's house

			Set4: {
				obj0: Raise the frame of the Merchant's house
				obj1: Put up its walls
				obj2: Furnish it
			}

			Set5.obj0: Build a house of your own design
			Set6.obj0: Check in with the Guide
		}
	}

	# A sample blueprint job (Content/Jobs/Townhome). Placeholder text.
	Townhome: {
		Name: Townhome
		Description: '''"Folks will need somewhere to live. I've drawn up the plans, if you'll do the building."'''

		Tasks: {
			Set0.obj0: Raise the frame
			Set1.obj0: Put up the walls
			Set2.obj0: Furnish the rooms
			Set3.obj0: Show the Guide
		}
	}

	CopperStandard: {
		Name: The Copper Standard
		Description:
			'''
			"Everybody's diggin' for gold, friend. Nobody's lookin' at what's lyin' right on top of it.
			I'm tellin' you, copper is the market of the future!"
			'''

		Tasks: {
			// GatherItemTask: {0} = item name, {1} = amount.
			Set0.obj0: Mine {0}

			Set1: {
				obj0: Smelt {0}
				obj1: Show the Merchant your bars
			}

			Set2: {
				obj0: Put copper on an arrow
				obj1: Put copper in a bullet
				obj2: Put copper in a boomerang
				obj3: Bring the Merchant his samples
			}

			Set3: {
				obj0: Put copper in a torch
				obj1: Put copper in some rope
				obj2: Put copper in a healing potion
				obj3: Bring the Merchant his samples
			}

			Set4: {
				obj0: Put copper in a bunny
				obj1: Bring the Merchant the bunny
			}
		}
	}

	# Goblin Tinkerer
	ExplosiveArchitecture: {
		Name: Explosive Architecture
		Description:
			'''
			"I just had a great idea for an invention!
			Help me gather the resources, and you'll get the first prototype!"
			'''

		Tasks: {
			Set0: {
				obj0: Gather Iron or Lead Bars
				obj1: Gather Dud Bombs
				obj2: Gather Lodestone
				obj3: Gather Magnetized Coils
			}

			Set1.obj0: Gather Walls for the W.A.L.L
		}
	}

	# The Dryad's Ingress arc (Content/Jobs/Jobs.Dryad). Placeholder text.
	CrossingOver: {
		Name: Crossing Over
		Description:
			'''
			"The rift will stay open for as long as you need it. Find your way through Ingress,
			past whatever guards it, and into the Library of Reverie."
			'''

		Tasks: {
			Set0.obj0: Step through the Dryad's rift into Ingress
			Set1.obj0: Defeat the Wooden Warden
			Set2.obj0: Find the Library of Reverie
		}
	}
}
