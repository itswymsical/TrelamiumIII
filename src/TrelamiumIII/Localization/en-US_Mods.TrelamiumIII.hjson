	# The caustic set.
	Virulent: {
		DisplayName: Virulent
		Description: Each affliction tick has a {0}% chance to spread it to an unafflicted enemy within {1} tiles
	}

	Acerbic: {
		DisplayName: Acerbic
		Description: Each affliction tick strips {0} more defense, up to {1}
	}

