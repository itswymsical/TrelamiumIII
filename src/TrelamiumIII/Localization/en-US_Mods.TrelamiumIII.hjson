SeedAmmo: {
	# {0} is the seed bed's item id, {1} its display name. The name is spelled out because the four
	# bed sprites read almost identically at tooltip size.
	FavouriteSoil: Favorite soil: [i:{0}] {1}
	Daybloom: Critical strikes grant temporary [buff:Ironskin]
	Blinkroot: Critical strikes grant temporary [buff:Hunter] and [buff:Swiftness]
	Moonglow: Critical strikes grant temporary [buff:Regeneration]
	Fireblossom: Critical strikes inflict [buff/f28755:OnFire] for a short duration
	Shiverthorn: Critical strikes inflict [buff/6fc5f6:Frostburn] for a short duration
	Deathweed: Critical strikes inflict [buff/87b041:Poisoned] for a short duration
	Waterleaf: Critical strikes inflict [buff/3d9eff:Wet] for a short duration
}

# Element names behind [chem:...]. Keyed by ChemicalDamageType member so a translation can name
# an element in its own words without every tooltip that mentions it having to change.
ChemicalDamageTypes: {
	# The elementless case: gel, powders, inert gas. Afflicts over time, no matchup, no reaction.
	Solute: Solute
	Thermal: Thermal
	Cryonic: Cryonic
	Caustic: Caustic
	Necrotic: Necrotic
	Kinetic: Kinetic
	Electric: Electric
	Reagent: Reagent
}

# The classification row under a chemical item's name (ChemicalRoleTag): which part it plays at
# the station, followed by the qualities it carries.
ChemicalRoles: {
	Solute: Solute
	Solvent: Solvent
	Solution: Solution
}

# The stat rows a controller weapon shows under its damage line (ChemicalStatsTooltip). Each row
# starts with the element's medallion, so the formats carry only the number and its unit.
ChemicalStats: {
	DamagePerSecond: "{0}/sec"
	ReactionChance: "{0}% reaction chance"
	Duration: "{0}s"
	# Plain-text stand-ins for readers that cannot draw the rows (search filters, other mods).
	# {0} element, {1} damage per second, {2} reaction damage, {3} reaction chance, {4} seconds.
	FallbackReactive: "{1} {0} per second, {2} reaction damage ({3}%), {4}s affliction"
	# {0} element, {1} damage per second, {2} seconds.
	FallbackPlain: "{1} {0} per second, {2}s affliction"
}

