Items: {
	AcornLauncherItem: {
		DisplayName: Acorn Launcher
		Tooltip: Charges and fires acorns at high velocity
	}

	SaplingMakerItem: {
		DisplayName: Sapling Maker
		Tooltip: Deals hefty knockback and can be charged up to blast several acorns
	}

	SharpnutDaggerItem: {
		DisplayName: Sharpnut Dagger
		Tooltip:
			'''
			Impales and sticks to enemies
			You deal 10% more damage on your target per impaled dagger
			'''
	}

	RustedIronBar: {
		DisplayName: Rusted Iron Bar
		Tooltip: ""
	}

	RustedIronBucket: {
		DisplayName: Rusted Iron Bucket
		Tooltip: ""
	}

	RustedIronPickaxe: {
		DisplayName: Rusted Iron Pickaxe
		Tooltip: ""
	}

	RustedIronSword: {
		DisplayName: Rusted Iron Sword
		Tooltip: ""
	}

	RustedAxe: {
		DisplayName: Rusted Axe
		Tooltip: ""
	}

	RustedHammer: {
		DisplayName: Rusted Hammer
		Tooltip: ""
	}

	RustedNugget: {
		DisplayName: Rusted Nugget
		Tooltip: ""
	}

	RustedPickaxe: {
		DisplayName: Rusted Pickaxe
		Tooltip: ""
	}

	TetanusShuriken: {
		DisplayName: Tetanus Shuriken
		Tooltip:
			'''
			Increases damage based on how many shurikens are stuck in your target
			Each shuriken increases damage by 10%
			'''
	}

	SporeclotSac: {
		DisplayName: Sporeclot Sac
		Tooltip:
			'''
			Sticks to enemies when tossed and builds up [buff:FungalInfection]
			Fungal Infection is a stackable debuff, that when fully stacked, causes enemies to explode into transmittable spores
			This effect can potentially chain across multiple targets
			'''
	}

	Girthquake: {
		DisplayName: Girthquake
		Tooltip:
			'''
			Must be lifted over your shoulders via holding attack.
			Slamming down the Girthquake shatters the earth beneath you, blasting out damaging shrapnel
			The longer you hold the girth, the bigger the boom...
			'''
	}

	OrphanSporeStaff: {
		DisplayName: Orphan Spore Staff
		Tooltip:
			'''
			Summons Fungore's orphaned child to fight for you
			Shroomson grows mushrooms on demand and throws them at your foes
			Left alone for long enough, he will grow one for you!
			'''
	}

	Myclobutanil: {
		DisplayName: Myclobutanil
		Tooltip:
			'''
			Eating certain mushrooms will flood you with life regeneration for 3 seconds (+750% life regen)
			After 3 seconds, your defense is stripped to nothing until potion sickness ends
			Reduces potion sickness afflicted by mushrooms to 25 seconds
			'''
		PermanentConsumable: Permanent {0}
	}

	FungoreBag: {
		DisplayName: Treasure Bag (Fungore)
		Tooltip: ""
	}

	FungoreMask: {
		DisplayName: Fungore Mask
		Tooltip: ""
	}

	FungoreTrophy: {
		DisplayName: Fungore Trophy
		Tooltip: ""
	}

	PossessedWorkshop: {
		DisplayName: Possessed Workshop
		Tooltip:
			'''
			Summons an apparition that haunts crafting stations
			Right click the apparition to give it crafting stations, doing so will possess them to follow you
			Each possessed station counts as a valid station for crafting
			'''
	}

	LodestoneItem: {
		DisplayName: Lodestone
		Tooltip: "'Highly magnetic'"
	}

	MagnetizedCoil: {
		DisplayName: Magnetized Coil
		Tooltip: Do not throw these at powerlines.
	}

	LodestoneMagnetizer: {
		DisplayName: Dusty Ol' Magnetizer
		Tooltip:
			'''
			Magnetizes ores out the ground with it's high powered vaccum
			Sucks so strong, it can pass through tiles!
			Cannot mine ores stronger than platinum
			'''
	}

	LodestoneHelmet: {
		DisplayName: Lodestone Mask
		Tooltip: Increases mining speed by 10%
	}

	LodestoneChestplate: {
		DisplayName: Lodestone Apron
		Tooltip: Increases damage reduction by 2%
	}

	LodestoneLeggings: {
		DisplayName: Lodestone Skirt
		Tooltip: Increases run acceleration by 10%
	}

	MicrolithItem: {
		DisplayName: Microlith
		Tooltip: When you break an ore chunk, it has a small chance to drop x1-x3 the ore value
	}

	BorealHewerItem: {
		DisplayName: Boreal Hewer
		Tooltip:
			'''
			Toss an axe that sticks to enemies and tiles
			The hewer will return to you after a short delay
			Has a small chance to inflict 'Frostburn'
			'''
	}

	FlailstormItem: {
		DisplayName: Flailstorm
		Tooltip:
			'''
			Swings slowly, and picks up speed with every full revolution
			Each revolution sheds clouds of freezing fog that inflict 'Frostburn'
			Damage, knockback and critical strike all climb as the ring builds
			At full charge, the thrown head bursts into damaging ice on impact
			'''
	}

	FrostbarkHelm: {
		DisplayName: Frostbark Helm
		Tooltip: Increases melee critical strike chance by 3%
	}

	FrostbarkHauberk: {
		DisplayName: Frostbark Hauberk
		Tooltip: Increases melee damage by 5%
	}

	FrostbarkGreaves: {
		DisplayName: Frostbark Greaves
		Tooltip: ""
	}

	AmberPendantItem: {
		DisplayName: Amber Pendant
		Tooltip: Increases max minions and sentries by 1
	}

	AmethystPendantItem: {
		DisplayName: Amethyst Pendant
		Tooltip:
			'''
			Increases damage reduction by 2%-10% depending on your current mana
			Requires 60 mana
			'''
	}

	DiamondPendantItem: {
		DisplayName: Diamond Pendant
		Tooltip: Increases critical strike chance by 10%
	}

	EmeraldPendantItem: {
		DisplayName: Emerald Pendant
		Tooltip:
			'''
			Increases defense by 2-8 depending on your current mana
			Requires 60 mana
			'''
	}

	RubyPendantItem: {
		DisplayName: Ruby Pendant
		Tooltip:
			'''
			Increases life regeneration 3%-10% depending on your current mana
			Requires 80 mana
			'''
	}

	SapphirePendantItem: {
		DisplayName: Sapphire Pendant
		Tooltip:
			'''
			Increases maximum mana by 40
			Decreases mana cost by 8%
			'''
	}

	TopazPendantItem: {
		DisplayName: Topaz Pendant
		Tooltip:
			'''
			Increases item pickup range
			Increases movement and acceleration speed 3%-8% depending on your current mana
			Requires 60 mana for movement bonus
			'''
	}

	SeedBedItem_Dirt: {
		DisplayName: Seed Bed (Dirt)
		Tooltip:
			'''
			Used to plant food, herbs, and flowers.
			Grows plants x5 faster than normal soil and planter boxes.
			'''
