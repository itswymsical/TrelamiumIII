# Tooltip lines SeedAmmoGlobalItem adds to vanilla herb seeds. Keyed here rather than on the item
# blocks above because the seeds are vanilla items, not content of this mod.
SeedAmmo: {
	# {0} is the seed bed's item id, {1} its display name. The name is spelled out because the four
	# bed sprites read almost identically at tooltip size.
	FavouriteSoil: Favorite soil: [i:{0}] {1}
	Daybloom: Critical strikes grant temporary [buff:Ironskin]
	Blinkroot: Critical strikes grant temporary [buff:Hunter] and [buff:Swiftness]
	Moonglow: Critical strikes grant temporary [buff:Regeneration]
	Fireblossom: Critical strikes inflict [buff/f28755:OnFire] for a short duration
	Shiverthorn: Critical strikes inflict [buff/6fc5f6:Frostburn] for a short duration
	Deathweed: Critical strikes inflict [buff/87b041:Poisoned] for a short duration
	Waterleaf: Critical strikes inflict [buff/3d9eff:Wet] for a short duration
}

# Element names behind [chem:...]. Keyed by ChemicalDamageType member so a translation can name
# an element in its own words without every tooltip that mentions it having to change.
ChemicalDamageTypes: {
	Thermal: Thermal
	Cryonic: Cryonic
	Caustic: Caustic
	Necrotic: Necrotic
	Kinetic: Kinetic
	Electric: Electric
}

DamageClasses.ChemicalDamageClass.DisplayName: controlled damage

