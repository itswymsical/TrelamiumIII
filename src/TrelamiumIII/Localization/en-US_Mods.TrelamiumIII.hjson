# Lines on soil blocks while the Botanist Glove is equipped (Content/Items/FarmingOverhaul/BotanistGlove).
SoilThrow: {
	Throw: Right-click to throw: {0} controlled damage
	Inflicts: Inflicts {0}
}

# Element names behind [chem:...]. Keyed by ChemicalDamageType member so a translation can name
# an element in its own words without every tooltip that mentions it having to change.
ChemicalDamageTypes: {
	# The elementless case: gel, powders, inert gas. Afflicts over time.
	Solute: Solute
	Thermal: Thermal
	Cryonic: Cryonic
	Caustic: Caustic
	Necrotic: Necrotic
	Kinetic: Kinetic
	Electric: Electric
	Reagent: Reagent
}

# The classification row under a chemical item's name (ChemicalRoleTag): which part it plays at
# the station, followed by the qualities it carries.
ChemicalRoles: {
	Solute: Solute
	Reagent: Reagent
	Solvent: Solvent
	Solution: Solution
}

# Category label shown by the alchemy station for the slotted ingredients (BrewCategories).
BrewCategories: {
	Synthesis: Synthesis
	Augmentation: Augmentation
	Refinement: Refinement
	Mixture: Mixture
	Transmutation: Transmutation
}

# The stat rows a controller weapon shows under its damage line (ChemicalStatsTooltip). Each row
# starts with the element's medallion, so the formats carry only the number and its unit.
ChemicalStats: {
	DamagePerSecond: "{0}/sec"
	ReactionChance: "{0}% reaction chance"
	Duration: "{0}s"
	Concentration: "{0} concentration"
	Catalysis: "{0}% catalysis"
	# Plain-text stand-ins for readers that cannot draw the rows (search filters, other mods).
	# {0} element, {1} damage per second, {2} reaction damage, {3} reaction chance, {4} seconds.
	FallbackReactive: "{1} {0} per second, {2} reaction damage ({3}%), {4}s affliction"
	# {0} element, {1} damage per second, {2} seconds.
	FallbackPlain: "{1} {0} per second, {2}s affliction"
}

# Modifiers on chemical releases (ChemicalModifier). Each takes an optional Description for behaviour its stat lines
# cannot show. Stats are the lines a modifier's changes print as, each given a signed number.
ChemicalModifiers: {
	Acidic.DisplayName: Acidic
	Alkaline.DisplayName: Alkaline
	Volatile.DisplayName: Volatile
	Kinetic.DisplayName: Kinetic
	Catalytic.DisplayName: Catalytic
	Inert.DisplayName: Inert
	Diluted.DisplayName: Diluted
	Concentrated.DisplayName: Concentrated
	Saturated.DisplayName: Saturated

	# Principles. Description arguments come from the modifier's tuning, so the text follows the numbers.
	Vital: {
		DisplayName: Vital
		Description: Reactions heal you for {0}% of the damage they deal
	}

	Specular: {
		DisplayName: Specular
		Description: Reactions are likelier on targets with more concentration, up to +{0}% at full
	}

	Martial: {
		DisplayName: Martial
		Description: Reactions deal {0}% more damage for each other element afflicting the target
	}

	Brisk.DisplayName: Brisk
	Fortunate.DisplayName: Fortunate

	Harmonious: {
		DisplayName: Harmonious
		Description: Hits also afflict the {0} nearest other enemies at {1}% strength
	}

	Baneful: {
		DisplayName: Baneful
		Description: Reactions lower the target's defense by {0} for {1} seconds
	}

	# The thermal set, rolled only by thermal weapons.
	Combustible: {
		DisplayName: Combustible
		Description: Reactions explode, dealing {1}% of their damage to enemies within {0} tiles and afflicting them at {2}% strength
	}

	Provocative: {
		DisplayName: Provocative
		Description: Reactions leap to up to {0} more enemies, each leap {1}% weaker
	}

	Inflammatory: {
		DisplayName: Inflammatory
		Description: Reactions consume the target's concentration for up to {0}% more damage
	}

	Dauntless: {
		DisplayName: Dauntless
		Description: Hits that don't react make the next one on that target {0}% likelier to, up to {1}%
	}

	Comburant: {
		DisplayName: Comburant
		Description: Reactions ignite your gas within {0} tiles in a blast of up to {1}% of their damage that grows with the gas burned
	}

	Igniting.DisplayName: Igniting
	Dwindling.DisplayName: Dwindling
	Warm.DisplayName: Warm
	Meek.DisplayName: Meek
	Amicable.DisplayName: Amicable

	# The cryonic set.
	Wintry: {
		DisplayName: Wintry
		Description: Everything it touches is chilled for {0}s
	}

	Hyperborean: {
		DisplayName: Hyperborean
		Description: Reactions freeze the target for {0}s; a reaction on a frozen target shatters it for {1}% more damage
	}

	Glacial: {
		DisplayName: Glacial
		Description: Reactions chill the target for {0}s
	}

	Brumal.DisplayName: Brumal
	Vaporous.DisplayName: Vaporous
	Temperate.DisplayName: Temperate
	Heated.DisplayName: Heated
	Lukewarm.DisplayName: Lukewarm
	Nippy.DisplayName: Nippy

	# The necrotic set.
	Vitiating: {
		DisplayName: Vitiating
		Description: Enemies that die afflicted by it burst, afflicting everything within {0} tiles at {1}% strength
	}

	Nullifying: {
		DisplayName: Nullifying
