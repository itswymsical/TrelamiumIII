Subworlds: {
	LoadingScreen.TipLabel: TIP

	Ingress: {
		DisplayName: Ingress

		Tips: {
			Brambleroot: Brambleroot runs beneath all of Ingress. Every cavern down there connects to another.
			LivingTrees: Living trees grow across the surface of Ingress, though never close to where you arrive.
			Heart: Something was built at the heart of the Ingress caverns.
		}
	}

	Reverie: {
		DisplayName: Reverie

		Tips: {
			Shelves: Every book that has ever existed rests somewhere in Reverie.
			Edith: Edith keeps the front desk. Ask her before you go wandering the stacks.
			Ropes: The walkways are reached by rope. Mind the drop.
		}
	}

	CanopyTreeLab.DisplayName: Canopy Tree Lab
	StructureLab.DisplayName: Structure Lab
